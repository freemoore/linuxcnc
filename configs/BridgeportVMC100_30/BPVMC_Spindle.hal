#  ---SPINDLE---

# ---everyday velocity run (Simodrive closes its own loop)---

net spindle-vel-cmd-rps         <=  spindle.0.speed-out-rps
net spindle-vel-cmd-rpm         <=  spindle.0.speed-out
net spindle-vel-cmd-rpm-abs     <=  spindle.0.speed-out-abs
net s-enable                    <=  spindle.0.on
net s-enable          			=>  spindle-pwm-en-or.in0
net orient-enable     			=>  spindle-pwm-en-or.in1
net spindle-pwm-enable  		<=  spindle-pwm-en-or.out
net spindle-pwm-enable  		=>  [HMOT](CARD0).pwmgen.05.enable

net spindle-cw                  <=  spindle.0.forward
net spindle-ccw                 <=  spindle.0.reverse

net input-spindle-speed-achieved  =>  spindle.0.at-speed
net spindle-drive-not-ready        =>  spindle.0.amp-fault-in

# ---PWM Generator signals/setup---
setp   [HMOT](CARD0).pwmgen.05.output-type 1
setp   [HMOT](CARD0).pwmgen.05.offset-mode 1 # offset mode so 50% = 0v
setp   [HMOT](CARD0).pwmgen.05.scale  [SPINDLE_0]OUTPUT_SCALE
setp   [HMOT](CARD0).pwmgen.05.dither 1

# ---Cartridge encoder (Renishaw ABZ) — position feedback for orient/sync---
setp    [HMOT](CARD0).encoder.05.counter-mode 0
setp    [HMOT](CARD0).encoder.05.filter 0
setp    [HMOT](CARD0).encoder.05.index-invert 1
setp    [HMOT](CARD0).encoder.05.scale  [SPINDLE_0]ENCODER_SCALE

net spindle-position    <=  [HMOT](CARD0).encoder.05.position
net spindle-position    =>  spindle.0.revs
net spindle-position    =>  s_orient.0.position
net spindle-position    =>  orient-pid.feedback

# shared 3-way index-enable (encoder / spindle / orient) — per forum fix
net spindle-index-enable    [HMOT](CARD0).encoder.05.index-enable   spindle.0.index-enable
net spindle-index-enable    s_orient.0.index-enable

# ---M19 orient (s_orient — homes to index unconditionally before orienting)---
net spindle-cmd-out          <=  spindle-mux.out
net spindle-cmd-out          =>  [HMOT](CARD0).pwmgen.05.value
net spindle-vel-cmd-rpm      =>  spindle-mux.in0
net orient-pid-out	orient-pid.output        =>  spindle-mux.in1

net orient-enable   spindle.0.orient        	=>  s_orient.0.enable  orient-pid.enable  spindle-mux.sel
net orient-angle    spindle.0.orient-angle  	=>  s_orient.0.angle
net orient-mode     spindle.0.orient-mode   	=>  s_orient.0.mode
net orient-command  s_orient.0.command      	=>  orient-pid.command
net spindle-oriented  s_orient.0.is-oriented  	=>  spindle.0.is-oriented

setp orient-pid.Pgain      [SPINDLE_0]ORIENT_P
setp orient-pid.Igain      [SPINDLE_0]ORIENT_I
setp orient-pid.Dgain      [SPINDLE_0]ORIENT_D
setp orient-pid.FF0        0
setp orient-pid.FF1        0
setp orient-pid.maxoutput  [SPINDLE_0]ORIENT_MAX_OUTPUT
setp orient-pid.deadband   [SPINDLE_0]ORIENT_DEADBAND
setp s_orient.0.tolerance  [SPINDLE_0]ORIENT_TOLERANCE
