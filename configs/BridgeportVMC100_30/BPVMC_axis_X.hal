#  ---AXIS X JOINT 0---
setp   pid.x.Pgain     [JOINT_0]P
setp   pid.x.Igain     [JOINT_0]I
setp   pid.x.Dgain     [JOINT_0]D
setp   pid.x.bias      [JOINT_0]BIAS
setp   pid.x.FF0       [JOINT_0]FF0
setp   pid.x.FF1       [JOINT_0]FF1
setp   pid.x.FF2       [JOINT_0]FF2
setp   pid.x.deadband  [JOINT_0]DEADBAND
setp   pid.x.maxoutput [JOINT_0]MAX_OUTPUT
setp   pid.x.error-previous-target true
net x-index-enable  =>  pid.x.index-enable
net x-enable        =>  pid.x.enable
net x-pos-cmd       =>  pid.x.command
net x-pos-fb        =>  pid.x.feedback
net x-output        <=  pid.x.output
# ---PWM Generator signals/setup---
setp   [HMOT](CARD0).pwmgen.00.output-type 1
setp   [HMOT](CARD0).pwmgen.00.offset-mode 1 # offset mode so 50% = 0
setp   [HMOT](CARD0).pwmgen.00.scale  [JOINT_0]OUTPUT_SCALE
setp   [HMOT](CARD0).pwmgen.00.dither 1
net x-output                             => [HMOT](CARD0).pwmgen.00.value
net x-pos-cmd    		joint.0.motor-pos-cmd
# ---Enable delay for amp fault reset
setp x-ena-delay.on-delay       1.5
setp x-ena-delay.off-delay      0
net x-enable     		joint.0.amp-enable-out  
net x-enable			x-ena-delay.in
net x-enable-delayed 	x-ena-delay.out
net x-enable-delayed	[HMOT](CARD0).pwmgen.00.enable
# ---Amp fault signals:
net input-x-over-temp     	x-amp-nok.in0
net input-x-ready  			x-amp-nok.in1
net x-amp-nok-s    			x-amp-nok.out      	x-fault-armed.in0
net x-enable-delayed                  			x-fault-armed.in1
net x-amp-fault    			x-fault-armed.out  	joint.0.amp-fault-in
# ---Encoder feedback signals/setup---
setp    [HMOT](CARD0).encoder.00.counter-mode 0
setp    [HMOT](CARD0).encoder.00.filter 0
setp    [HMOT](CARD0).encoder.00.index-invert 1
setp    [HMOT](CARD0).encoder.00.index-mask 0
setp    [HMOT](CARD0).encoder.00.index-mask-invert 0
setp    [HMOT](CARD0).encoder.00.scale  [JOINT_0]ENCODER_SCALE
net x-pos-fb               <=  [HMOT](CARD0).encoder.00.position
net x-vel-fb               <=  [HMOT](CARD0).encoder.00.velocity
net x-pos-fb               =>  joint.0.motor-pos-fb
net x-index-enable    joint.0.index-enable  <=>  [HMOT](CARD0).encoder.00.index-enable
net x-pos-rawcounts        <=  [HMOT](CARD0).encoder.00.rawcounts
# ---setup home / limit switch signals---
net input-x-ref     	 =>  joint.0.home-sw-in
#net x-neg-limit     =>  joint.0.neg-lim-sw-in
#net x-pos-limit     =>  joint.0.pos-lim-sw-in
