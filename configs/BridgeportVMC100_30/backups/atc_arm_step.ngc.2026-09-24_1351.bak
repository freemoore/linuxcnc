o<atc_arm_step> sub
; Advance arm to its next dwell:
;   rest    -> release  needs pocket down; orients + moves Z first
;   release -> fasten   needs spindle unclamped
;   fasten  -> rest     needs spindle clamped
M66 P3 L0 Q0
#<rest> = #5399
M66 P1 L0 Q0
#<rel> = #5399
M66 P2 L0 Q0
#<fas> = #5399
o1 if [#<rest> EQ 1]
  o<atc_req_pocket_down> call
  o<atc_prep> call
  o<atc_arm_run_to> call [1] [10]
o1 elseif [#<rel> EQ 1]
  o<atc_req_unclamped> call
  o<atc_arm_run_to> call [2] [10]
o1 elseif [#<fas> EQ 1]
  o<atc_req_clamped> call
  o<atc_arm_reset> call
o1 else
  (abort, atc_arm_step: arm between positions - run atc_arm_reset)
o1 endif
o<atc_arm_step> endsub
M2
