# Generated by PNCconf at Mon Jul 27 16:42:02 2026
# Using LinuxCNC version:  Master (2.9)
# If you make changes to this file, they will be
# overwritten when you run PNCconf again

[EMC]
MACHINE = BridgeportVMC100_30
DEBUG = 0
VERSION = 1.1

[DISPLAY]
DISPLAY = axis
#GLADEVCP = -H gvcp_call_list.hal gvcp-panel.ui
POSITION_OFFSET = RELATIVE
POSITION_FEEDBACK = ACTUAL
MAX_FEED_OVERRIDE = 8.000000
MAX_SPINDLE_OVERRIDE = 2.000000
MIN_SPINDLE_OVERRIDE = 0.500000
INTRO_GRAPHIC = linuxcnc.gif
INTRO_TIME = 5
PROGRAM_PREFIX = /home/freemoore/linuxcnc/nc_files
OPEN_FILE =""
INCREMENTS = 5mm 1mm .5mm .1mm .05mm .01mm .005mm .001mm
POSITION_FEEDBACK = ACTUAL
DEFAULT_LINEAR_VELOCITY = 50.000000
MAX_LINEAR_VELOCITY = 333.4
MIN_LINEAR_VELOCITY = 0.00000
MAX_ANGULAR_VELOCITY = 90.00
DEFAULT_ANGULAR_VELOCITY = 60.00
MIN_ANGULAR_VELOCITY = 0.1
EDITOR = geany
GEOMETRY = !XYZA
CYCLE_TIME = 100
EMBED_TAB_NAME=PSNG
EMBED_TAB_COMMAND=gladevcp -c probe -x {XID} -u psng/python/probe_screen.py -H psng/psng.hal psng/probe_screen.glade


[FILTER]
PROGRAM_EXTENSION = .png,.gif,.jpg Greyscale Depth Image
PROGRAM_EXTENSION = .py Python Script
png = image-to-gcode
gif = image-to-gcode
jpg = image-to-gcode
py = python

[TASK]
TASK = milltask
CYCLE_TIME = 0.010

[RS274NGC]
PARAMETER_FILE = linuxcnc.var
RS274NGC_STARTUP_CODE = G21 G40 G90 G94 G97 G64 P0.025
PYTHON_PATH = /usr/share/linuxcnc/ncfiles/remap_lib/python-stdglue/python/
#REMAP= M6 modalgroup=6  prolog=change_prolog ngc=toolchange epilog=change_epilog
#SUBROUTINE_PATH = ./
# ---- PSNG start ---- #
RETAIN_G43 = 0
INI_VARS = 1
HAL_PIN_VARS = 1
SUBROUTINE_PATH = ./:macros:psng/macros
#REMAP=M6   modalgroup=6  prolog=change_prolog  ngc=psng_manual_change  epilog=change_epilog
REMAP=M6   modalgroup=6  prolog=change_prolog  ngc=toolchange  epilog=change_epilog
# ---- PSNG end ---- #

[EMCMOT]
EMCMOT = motmod
COMM_TIMEOUT = 1.0
SERVO_PERIOD = 1000000
NUM_DIGITAL_IO = 8
NUM_ANALOG_OUT = 1

[HMOT]
# **** This is for info only ****
CARD0=hm2_7i97.0
CARD1=7i84.0.3

[HAL]
HALUI = halui
HALFILE = BridgeportVMC100_30.hal
HALFILE = BPVMC_IO.hal
HALFILE = BPVMC_axis_X.hal
HALFILE = BPVMC_axis_Y.hal
HALFILE = BPVMC_axis_Z.hal
HALFILE = BPVMC_axis_A.hal
HALFILE = BPVMC_Spindle.hal
HALFILE = BPVMC_Toolchanger.hal
HALFILE = custom.hal
POSTGUI_HALFILE = custom_postgui.hal
SHUTDOWN = shutdown.hal

[HALUI]
#MDI_COMMAND = G10 L20 P0 X0 ( Set X to zero )
#MDI_COMMAND = G10 L20 P0 Y0 ( Set Y to zero )
#MDI_COMMAND = G10 L20 P0 Z0 ( Set Z to zero )
#MDI_COMMAND = G10 L20 P0 A0 ( Set A to zero )

[KINS]
JOINTS = 4
KINEMATICS = trivkins coordinates=XYZA

[TRAJ]
COORDINATES =  XYZA
MAX_ANGULAR_VELOCITY = 90.00
DEFAULT_ANGULAR_VELOCITY = 60.00
LINEAR_UNITS = mm
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = 8.33
MAX_LINEAR_VELOCITY = 533.33
POSITION_FILE = position.txt

[PROBE_SCREEN]
# Offset from [AXIS_Z]MAX_LIMIT for performing moves during various probe
# screen movements. This must be a negative number.
Z_SAFE_TRAVEL_OFFSET = -0.1

#[TOOLCHANGE]: 
#Z_POS = 17

[TOOLSENSOR]
# Absolute coordinates of the toolsetter pad
X = 0
Y = 0
# Absolute Z start search coordinates
Z = 0
# Maximum search distance and direction (sign)
MAXPROBE = -50
# Speed of movements during working in Probe Screen
RAPID_SPEED = 600
# Diameter of toolsetter pad 
TS_DIAMETER = 20
# The speed of the reverse rotation of the spindle when measuring the tool diameter
REV_ROTATION_SPEED = 2000

[CHANGE_POSITION]
# Absolute coordinates of the tool change point
X = 0
Y = 0
Z = 17

[PYTHON]
PATH_PREPEND = ./python
TOPLEVEL = python/toplevel.py

[EMCIO]
EMCIO = io
CYCLE_TIME = 0.100
TOOL_TABLE = tool.tbl
TOOL_CHANGE_QUILL_UP = 1
RANDOM_TOOLCHANGER = 1

