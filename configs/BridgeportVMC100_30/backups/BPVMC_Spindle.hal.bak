#  ---SPINDLE---
# PID retained but bypassed until spindle encoder feedback is wired.
setp   pid.s.Pgain     [SPINDLE_0]P
setp   pid.s.Igain     [SPINDLE_0]I
setp   pid.s.Dgain     [SPINDLE_0]D
setp   pid.s.bias      [SPINDLE_0]BIAS
setp   pid.s.FF0       [SPINDLE_0]FF0
setp   pid.s.FF1       [SPINDLE_0]FF1
setp   pid.s.FF2       [SPINDLE_0]FF2
setp   pid.s.deadband  [SPINDLE_0]DEADBAND
setp   pid.s.maxoutput [SPINDLE_0]MAX_OUTPUT
setp   pid.s.error-previous-target true

# --- CLOSED LOOP: uncomment when encoder is in. Also swap the
#     pwmgen.05.value net below from spindle-vel-cmd-rpm to spindle-output.
net spindle-index-enable  	=>  pid.s.index-enable
net spindle-enable        	=>  pid.s.enable
net spindle-vel-cmd-rpm     =>  pid.s.command

#next line shorts pid so fb = output
net spindle-vel-cmd-rpm 	=>  pid.s.command
#and should be:
#net spindle-vel-fb-rpm     =>  pid.s.feedback

net spindle-output        	<=  pid.s.output

# ---setup spindle control signals---

net spindle-vel-cmd-rps        	<=  spindle.0.speed-out-rps
net spindle-vel-cmd-rps-abs    	<=  spindle.0.speed-out-rps-abs
net spindle-vel-cmd-rpm        	<=  spindle.0.speed-out
net spindle-vel-cmd-rpm-abs    	<=  spindle.0.speed-out-abs
net s-enable             		<=  spindle.0.on
net spindle-cw                 	<=  spindle.0.forward
net spindle-ccw                	<=  spindle.0.reverse
#net spindle-brake              <=  spindle.0.brake

# ---PWM Generator signals/setup---

setp   [HMOT](CARD0).pwmgen.05.output-type 1
setp   [HMOT](CARD0).pwmgen.05.offset-mode 1 # offset mode so 50% = 0v
setp   [HMOT](CARD0).pwmgen.05.scale  [SPINDLE_0]OUTPUT_SCALE
setp   [HMOT](CARD0).pwmgen.05.dither 1

# OPEN LOOP: signed RPM command straight to the DAC, sign = direction
net spindle-vel-cmd-rpm        =>  [HMOT](CARD0).pwmgen.05.value

#setp s-ena-delay.on-delay       1.5
#setp s-ena-delay.off-delay      0
#net s-enable     		joint.0.amp-enable-out  
#net s-enable			s-ena-delay.in
#net s-enable-delayed 	s-ena-delay.out
#net s-enable-delayed	[HMOT](CARD0).pwmgen.05.enable


# ---spindle drive enable and start---
# output-spin_strt also lands on CARD1 output-04 in BPVMC_IO.hal
net s-enable                   =>  [HMOT](CARD0).pwmgen.05.enable
#net output-spin_strt           <=  spindle.0.on


# ---Amp fault signals:
#net input-x_ot     x-amp-nok.in0
#net input-x_ready  x-amp-nok.in1
#net x-amp-nok-s    x-amp-nok.out      x-fault-armed.in0
#net x-enable-delayed                  x-fault-armed.in1
#net x-amp-fault    x-fault-armed.out  joint.5.amp-fault-in

net input-spindle-speed-achieved  			=>  spindle.0.at-speed

net spindle-revs               =>  spindle.0.revs
#net spindle-at-speed           =>  spindle.0.at-speed
net spindle-vel-fb-rps         =>  spindle.0.speed-in
net spindle-index-enable      <=>  spindle.0.index-enable
setp [HMOT](CARD0).encoder.05.index-invert 1

# ---Setup spindle at speed signals---

#sets spindle-at-speed true
