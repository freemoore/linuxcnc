loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_dio=[EMCMOT]NUM_DIGITAL_IO
loadrt hostmot2
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_pktuarts=1 sserial_port_0=0000000" 
loadrt pid names=pid.x,pid.y,pid.z,pid.a,orient-pid
loadrt abs names=abs.spindle
loadrt lowpass names=lowpass.spindle
loadrt timedelay names=x-ena-delay,y-ena-delay,z-ena-delay,a-ena-delay,s-ena-delay,mag-guard-hold,probe-link-grace,startup-settle
loadrt oneshot   names=drv-reset,mag-guard-unlock,probe-power-hold,air-restored-pulse
loadrt or2  names=x-amp-nok,y-amp-nok,z-amp-nok,a-amp-nok,s-amp-nok,tool-unclamp-or,spindle-pwm-en-or,mag-guardlock-or
loadrt and2 names=x-fault-armed,y-fault-armed,z-fault-armed,a-fault-armed,s-fault-armed,mag-jog-both,air-absent-gate,probe-lowbat-gate
loadrt logic names=man-unclamp,mag-jog-fwd,mag-jog-rev personality=0x104,0x103,0x103
loadrt s_orient names=s_orient.0
loadrt mux2 names=spindle-mux
loadrt not names=mag-th-not
# carousel: encoding=index (sense-0 = index/home pulse, sense-1 = per-pocket counter), 30 pockets
loadrt carousel pockets=30 encoding=index num_sense=2
loadrt conv_float_s32 names=pocketnoconv
loadrt conv_s32_float names=pocketposconv
loadrt lut5 names=mag-carousel-arrived,mag-shotbolt-gate,probe-ready-logic,probe-input-logic,probe-alarm-logic



setp    [HMOT](CARD0).pwmgen.pwm_frequency 75000
setp    [HMOT](CARD0).watchdog.timeout_ns 10000000

addf [HMOT](CARD0).read         servo-thread
addf motion-command-handler   	servo-thread
addf motion-controller       	servo-thread
addf pid.x.do-pid-calcs       	servo-thread
addf pid.y.do-pid-calcs       	servo-thread
addf pid.z.do-pid-calcs       	servo-thread
addf pid.a.do-pid-calcs       	servo-thread
addf orient-pid.do-pid-calcs   	servo-thread
addf x-ena-delay  				servo-thread
addf y-ena-delay  				servo-thread
addf z-ena-delay  				servo-thread
addf a-ena-delay  				servo-thread
addf s-ena-delay  				servo-thread
addf drv-reset  				servo-thread
addf x-amp-nok     				servo-thread
addf x-fault-armed 				servo-thread
addf y-amp-nok     				servo-thread
addf y-fault-armed 				servo-thread
addf z-amp-nok     				servo-thread
addf z-fault-armed 				servo-thread
addf a-amp-nok     				servo-thread
addf a-fault-armed 				servo-thread
addf s-amp-nok     				servo-thread
addf s-fault-armed 				servo-thread
addf abs.spindle             	servo-thread
addf man-unclamp  				servo-thread
addf tool-unclamp-or  			servo-thread
addf lowpass.spindle          	servo-thread
addf s_orient.0 				servo-thread
addf spindle-mux 				servo-thread
addf spindle-pwm-en-or 			servo-thread
addf mag-jog-both 				servo-thread
addf startup-settle				servo-thread
addf air-absent-gate			servo-thread
addf air-restored-pulse		servo-thread
addf mag-guard-hold 			servo-thread
addf mag-guard-unlock 			servo-thread
addf mag-jog-fwd 				servo-thread
addf mag-jog-rev 				servo-thread
addf mag-th-not					servo-thread
addf pocketnoconv				servo-thread
addf carousel.0					servo-thread
addf pocketposconv				servo-thread
addf mag-carousel-arrived		servo-thread
addf mag-shotbolt-gate			servo-thread
addf mag-guardlock-or 			servo-thread
addf probe-power-hold			servo-thread
addf probe-link-grace			servo-thread
addf probe-ready-logic			servo-thread
addf probe-input-logic			servo-thread
addf probe-alarm-logic			servo-thread
addf probe-lowbat-gate			servo-thread
addf [HMOT](CARD0).write        servo-thread

#******************************
# connect miscellaneous signals
#******************************

#  ---HALUI signals---
net axis-select-x  			halui.axis.x.select
net jog-x-pos      			halui.axis.x.plus
net jog-x-neg      			halui.axis.x.minus
net jog-x-analog   			halui.axis.x.analog
net x-is-homed     			halui.joint.0.is-homed
net axis-select-y  			halui.axis.y.select
net jog-y-pos      			halui.axis.y.plus
net jog-y-neg      			halui.axis.y.minus
net jog-y-analog   			halui.axis.y.analog
net y-is-homed     			halui.joint.1.is-homed
net axis-select-z  			halui.axis.z.select
net jog-z-pos      			halui.axis.z.plus
net jog-z-neg      			halui.axis.z.minus
net jog-z-analog   			halui.axis.z.analog
net z-is-homed     			halui.joint.2.is-homed
net axis-select-a  			halui.axis.a.select
net jog-a-pos      			halui.axis.a.plus
net jog-a-neg      			halui.axis.a.minus
net jog-a-analog   			halui.axis.a.analog
net a-is-homed     			halui.joint.3.is-homed
net jog-selected-pos      	halui.axis.selected.plus
net jog-selected-neg      	halui.axis.selected.minus
net spindle-manual-cw     	halui.spindle.0.forward
net spindle-manual-ccw   	halui.spindle.0.reverse
net spindle-manual-stop  	halui.spindle.0.stop
net machine-is-on        	halui.machine.is-on
net jog-speed            	halui.axis.jog-speed
net MDI-mode             	halui.mode.is-mdi

#  ---coolant signals---
net coolant-mist      <=  iocontrol.0.coolant-mist
net output-coolant    <=  iocontrol.0.coolant-flood    # M8 -> 7CR flood pump

#  ---probe signal---
# GP-800 wireless probe power management. SSR out-01 switches the receiver's
# +24 V supply (red); brown is tied to 0 V (always 'probe on' when powered).
# Receiver off -> probe loses link and sleeps. NGC pulses P8 (o<probe_wake>, called by
# every PSNG macro via macros/_psng_hook.ngc); each pulse (re)starts a 2 min hold.
setp probe-power-hold.width         120
setp probe-power-hold.retriggerable 1
setp probe-power-hold.rising        1
setp probe-power-hold.falling       0
net probe-wake-request  motion.digital-out-08  =>  probe-power-hold.in
net probe-power         probe-power-hold.out   =>  [HMOT](CARD0).ssr.00.out-01

# Ready = powered AND powered for > 4 s (receiver start-up; its outputs float
# while unpowered) AND radio link OK (probe-signal-fault is the receiver's yellow
# alarm line, TRUE = no link). lut5 in-0 = power, in-1 = fault, in-2 = settled:
# 0x20 = in-0 AND NOT in-1 AND in-2. NGC waits on din P10.
setp probe-ready-logic.function 0x20
net probe-power                          =>  probe-ready-logic.in-0
net probe-signal-fault                   =>  probe-ready-logic.in-1
net probe-power-settled                  =>  probe-ready-logic.in-2
net probe-ready    probe-ready-logic.out  =>  motion.digital-in-10

# motion.probe-input = wireless trigger OR tool setter OR NOT probe-ready.
# Crash guard: a G38 with the wireless probe asleep or unlinked is refused as
# 'already tripped' (the probe's own output reads 'not triggered' when off).
# lut5 0xEF = in-0 OR in-1 OR NOT in-2
setp probe-input-logic.function 0xEF
net digitising-probe-input               =>  probe-input-logic.in-0
net input-tool-setter-probe              =>  probe-input-logic.in-1
net probe-ready                          =>  probe-input-logic.in-2
net probe-input    probe-input-logic.out  =>  motion.probe-input

# Signal-fault alarm: powered for >4 s (receiver start-up grace) AND no link.
# lut5 0x8 = in-0 AND in-1. Message component is in custom.hal.
setp probe-link-grace.on-delay  4
setp probe-link-grace.off-delay 0
net probe-power                          =>  probe-link-grace.in
net probe-power-settled probe-link-grace.out => probe-alarm-logic.in-0
net probe-signal-fault                   =>  probe-alarm-logic.in-1
net probe-signal-alarm probe-alarm-logic.out

# Low-battery warning: the white line reads 'low' for ~2.4 s while the receiver
# starts. Gate it with probe-power-settled, like the signal-fault warning.
net probe-power-settled                  =>  probe-lowbat-gate.in0
net probe-low-voltage                    =>  probe-lowbat-gate.in1
net probe-lowbat-alarm  probe-lowbat-gate.out

#  ---motion control signals---
net in-position               <=  motion.in-position
net machine-is-enabled        <=  motion.motion-enabled

# terminal block X141 on the 611 power unit (leftmost) has terminals R and M(15)
# - short these together to reset drive errors. 
# do a 0.5s oneshot on linuxcnc's 'power on button' signal. 
# also oneshot-delay x/y/z/a/s enable pins by 1s to prevent this interfering with the reset.
setp drv-reset.width          0.5
setp drv-reset.rising         1
setp drv-reset.falling        0
setp drv-reset.retriggerable  0

net machine-is-enabled      	drv-reset.in  
net drv-reset-signal		  	drv-reset.out       [HMOT](CARD0).ssr.00.out-00
# SSR out-01 = probe receiver power on/off - see probe power management above

#  ---estop signals---
net estop-out     <=  iocontrol.0.user-enable-out
net estop-out     =>  iocontrol.0.emc-enable-in

#  ---toolchange signals for custom tool changer---


#net tool-prepared 			iocontrol.0.tool-prepare 	=> 	 iocontrol.0.tool-prepared
