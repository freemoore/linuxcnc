# Include your custom HAL commands here
# This file will not be overwritten when you run PNCconf again

#---------------------------------
loadrt message names=airloss,airgood,probelowbat,probesigfault messages="air supply off - motion inhibited,air supply on,probe battery is low,probe signal fault"
addf airloss servo-thread
addf airgood servo-thread
addf probelowbat servo-thread
addf probesigfault servo-thread
setp airloss.edge 1
setp airgood.edge 1
setp probelowbat.edge 1
setp probesigfault.edge 1

net input-air-supply-absent  => motion.feed-inhibit

# The air input flickers while the 7i84 link comes up. Gate the messages until
# 3 s after start. Then: one 'air off' note at start only if air is off, and a
# note on each later change. startup-settle / air-absent-gate are loaded in the
# main HAL.
setp startup-settle.in        1
setp startup-settle.on-delay  3
setp startup-settle.off-delay 0
net startup-settled          startup-settle.out  => air-absent-gate.in0
net input-air-supply-absent                      => air-absent-gate.in1
net air-supply-absent-gated  air-absent-gate.out => airloss.trigger air-restored-pulse.in

# 'air on' message: pulse on the falling edge of the gated signal. The message
# component gives a false falling edge at start when edge = 0, so use oneshot.
setp air-restored-pulse.rising  0
setp air-restored-pulse.falling 1
setp air-restored-pulse.width   0.5
net air-supply-restored  air-restored-pulse.out => airgood.trigger

# GP-800 probe warnings (signals built in BridgeportVMC100_30.hal)
net probe-low-voltage    =>  probelowbat.trigger
net probe-signal-alarm   =>  probesigfault.trigger
#---------------------------------
