<?xml version="1.0" encoding="UTF-8"?>
<!-- ATC troubleshooting tab - Bridgeport VMC1000/30. Buttons run atc_subroutines via MDI.
     Generated layout; handler atc_panel/atc.py fills the magazine table. -->
