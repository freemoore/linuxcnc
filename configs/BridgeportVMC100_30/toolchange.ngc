o<toolchange> sub

; ============================================================
; Bridgeport VMC1000/30 - ATC tool change (M6 remap)
; Sequence built from atc_subroutines/*.ngc - each step aborts
; the program with its own message on failure. The arm motor is
; stopped before any arm abort; ambo is left ON so the arm can be
; eased by hand.
;
; I/O map: see BPVMC_Toolchanger.hal
;   out P0 carousel enable   P1 magazine lock (high = released)
;       P2 arm motor (21CR)  P3 ambo (52CR)   P4 unclamp (11CR)
;       P5 pocket down       P7 taper blast
;   in  P0 carousel ready    P1 arm release   P2 arm fasten
;       P3 arm rest          P4 pocket up     P5 pocket down
;       P6 clamped           P7 unclamped
;
; Needs atc_subroutines on [RS274NGC]SUBROUTINE_PATH.
; ============================================================

G90             ; never trust incoming modal state (PSNG may leave G91)

(debug, TC: entered - tool=#<selected_tool> pocket=#<selected_pocket>)

; Orient spindle, move to tool change Z
(debug, TC: prep - M19 and tool change Z)
o<atc_prep> call

; Pocket up so the magazine can turn. Aborts if the arm isn't at rest -
; recover by hand / atc_arm_reset after checking spindle and pocket.
(debug, TC: pocket up)
o<atc_pocket_up> call

; Index to the new tool. Magazine lock is released only for the move
; (atc_lock_release / atc_lock_engage, inside atc_pocket).
(debug, TC: indexing to pocket #<selected_pocket>)
o<atc_pocket> call [#<selected_pocket>]

; Present new tool to the arm path
(debug, TC: pocket down)
o<atc_pocket_down> call

; Arm: rest -> release (both tools gripped). Motor stops, ambo stays on.
(debug, TC: arm to release position)
o<atc_arm_run_to> call [1] [5]

; Unclamp old tool (SIDEPAL: ~200ms from release position)
G4 P0.2
(debug, TC: unclamp)
o<atc_unclamp> call

; Taper wash
G4 P0.5
(debug, TC: air blast)
o<atc_blast> call

; Arm: release -> fasten (180deg swap, new tool at spindle)
(debug, TC: arm to fasten position)
o<atc_arm_run_to> call [2] [5]

; Clamp new tool
G4 P0.3
(debug, TC: clamp)
o<atc_clamp> call

; Arm: fasten -> rest, then motor off and brake on
(debug, TC: arm to rest)
o<atc_arm_reset> call

; Pocket up - secures old tool in the carousel
(debug, TC: pocket up)
o<atc_pocket_up> call

(debug, TC: tool change complete)
o<toolchange> endsub [1]
M2
