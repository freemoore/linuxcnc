o<atc_arm_step> sub
; Advance arm to its next dwell:
;   rest -> release (grips both tools)   needs pocket down; does orient + Z
;   release -> fasten (180 deg swap)     needs spindle UNCLAMPED
;   fasten -> rest                       needs spindle CLAMPED
M66 P3 L0 Q0
#<rest> = #5399
M66 P1 L0 Q0
#<rel> = #5399
M66 P2 L0 Q0
#<fas> = #5399

o1 if [#<rest> EQ 1]
  M66 P5 L0 Q0
  o11 if [#5399 LT 1]
    (abort, atc_arm_step: pocket not down)
  o11 endif
  o<atc_prep> call
  M64 P3                ; ambo on
  M64 P2                ; arm motor on
  M66 P3 L2 Q5          ; leave rest
  o12 if [#5399 LT 0]
    M65 P2
    M65 P3
    (abort, atc_arm_step: arm did not leave rest)
  o12 endif
  M66 P1 L3 Q10         ; reach release position
  #<ok> = #5399
  M65 P2                ; motor off, ambo stays on
  o13 if [#<ok> LT 0]
    M65 P3
    (abort, atc_arm_step: release position not reached)
  o13 endif

o1 elseif [#<rel> EQ 1]
  M66 P7 L0 Q0
  o21 if [#5399 LT 1]
    (abort, atc_arm_step: spindle not unclamped - run atc_unclamp)
  o21 endif
  M64 P3
  M64 P2
  M66 P2 L3 Q10         ; reach fasten position
  #<ok> = #5399
  M65 P2
  o22 if [#<ok> LT 0]
    M65 P3
    (abort, atc_arm_step: fasten position not reached)
  o22 endif

o1 elseif [#<fas> EQ 1]
  M66 P6 L0 Q0
  o31 if [#5399 LT 1]
    (abort, atc_arm_step: spindle not clamped - run atc_clamp)
  o31 endif
  M64 P3
  M64 P2
  M66 P3 L3 Q15         ; back to rest
  #<ok> = #5399
  M65 P2
  M65 P3                ; ambo off, brake on
  o32 if [#<ok> LT 0]
    (abort, atc_arm_step: rest not reached)
  o32 endif

o1 else
  (abort, atc_arm_step: arm between positions - run atc_arm_rest)
o1 endif
o<atc_arm_step> endsub
M2
