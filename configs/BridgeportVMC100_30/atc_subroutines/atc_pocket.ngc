o<atc_pocket> sub
; Index carousel to pocket #1.  Usage: o<atc_pocket> call [12]
; Homes first if the carousel is unhomed.
o1 if [[#1 LT 1] OR [#1 GT 30]]
  (abort, atc_pocket: pocket must be 1-30)
o1 endif
o<atc_req_pocket_up> call
o<atc_req_arm_rest> call
; Make sure carousel.comp is idle: it only starts on enable going TRUE, and
; sits in its 'done' state while enable stays TRUE.
M65 P0
G4 P0.05
; Unhomed: home first. Index homing always ends at pocket 1.
M66 P8 L0 Q0            ; homed
o3 if [#5399 LT 1]
  o<atc_pocket_move> call [1]
o3 endif
; Already there - nothing to do
M66 E0 L0               ; current pocket
o4 if [#5399 EQ #1]
  o<atc_pocket> return
o4 endif
o<atc_pocket_move> call [#1]
o<atc_pocket> endsub
M2
