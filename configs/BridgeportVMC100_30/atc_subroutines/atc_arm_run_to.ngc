o<atc_arm_run_to> sub
; Run arm until input P#1 goes HIGH, timeout #2 s. Motor stops, ambo stays on
; (also on timeout - brake off lets the arm be eased by hand).
; Usage: o<atc_arm_run_to> call [1] [5]
M64 P3                  ; ambo on
M64 P2                  ; arm motor on
M66 P#1 L3 Q#2
#<ok> = #5399
M65 P2
o1 if [#<ok> LT 0]
  (debug, atc_arm_run_to: timed out waiting for input P#1)
  (abort, atc_arm_run_to: arm did not reach position - see debug line)
o1 endif
o<atc_arm_run_to> endsub
M2
