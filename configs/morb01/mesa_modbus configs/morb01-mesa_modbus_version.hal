loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt hostmot2
#loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_pktuarts=1 sserial_port_0=0xxxxxxx" 
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_pktuarts=1 sserial_port_0=0000000" 

loadrt 16IOrelayboard00 ports=[HMOT](CARD0).pktuart.0
#loadrt 16IOrelayboard01 ports=[HMOT](CARD0).pktuart.0
#loadrt 16IOrelayboard02 ports=[HMOT](CARD0).pktuart.0

addf 16IOrelayboard00.00 		servo-thread
addf 16IOrelayboard01.00 		servo-thread
addf 16IOrelayboard02.00 		servo-thread


setp    [HMOT](CARD0).pwmgen.pwm_frequency 75000
setp    [HMOT](CARD0).watchdog.timeout_ns 10000000

loadrt pid names=pid.x,pid.y,pid.z,pid.s

addf [HMOT](CARD0).read          servo-thread
addf motion-command-handler   servo-thread
addf motion-controller        servo-thread
addf pid.x.do-pid-calcs       servo-thread
addf pid.y.do-pid-calcs       servo-thread
addf pid.z.do-pid-calcs       servo-thread
addf pid.s.do-pid-calcs       servo-thread

addf [HMOT](CARD0).write         servo-thread
#setp [HMOT](CARD0).dpll.01.timer-us -50

setp 16IOrelayboard00.00.address 1
setp 16IOrelayboard00.00.baudrate 9600
setp 16IOrelayboard00.00.parity 0
setp 16IOrelayboard00.00.update-hz 1000

#setp 16IOrelayboard01.00.address 2
#setp 16IOrelayboard01.00.baudrate 9600
#setp 16IOrelayboard01.00.parity 0
