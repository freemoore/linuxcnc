net io-pnpmb02-out22 => wsum.3.bit.5.in
net io-pnpmb02-out23 => wsum.3.bit.6.in
net io-pnpmb02-out24 => wsum.3.bit.7.in
net io-pnpmb02-out25 => wsum.3.bit.8.in
net io-pnpmb02-out26 => wsum.3.bit.9.in
net io-pnpmb02-out27 => wsum.3.bit.10.in
net io-pnpmb02-out28 => wsum.3.bit.11.in
net io-pnpmb02-out29 => wsum.3.bit.12.in
net io-pnpmb02-out30 => wsum.3.bit.13.in
net io-pnpmb02-out31 => wsum.3.bit.14.in
net io-pnpmb02-out32 => wsum.3.bit.15.in

# NOTE: wsum.4 (size 2) is used by the VFD spindle control word logic
# in the spindle HaL file. Reference there updated from wsum.3 to wsum.4.
