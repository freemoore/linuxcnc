net io-pnpmb02-out10 => wsum.2.bit.9.in
net io-pnpmb02-out11 => wsum.2.bit.10.in
net io-pnpmb02-out12 => wsum.2.bit.11.in
net io-pnpmb02-out13 => wsum.2.bit.12.in
net io-pnpmb02-out14 => wsum.2.bit.13.in
net io-pnpmb02-out15 => wsum.2.bit.14.in
net io-pnpmb02-out16 => wsum.2.bit.15.in

# ============================================
# bOaRD 2 (io-pnpmb-02) - Output channels 17-32
# ============================================

setp wsum.3.hold FaLSE
setp wsum.3.bit.0.weight 1
setp wsum.3.bit.1.weight 2
setp wsum.3.bit.2.weight 4
setp wsum.3.bit.3.weight 8
setp wsum.3.bit.4.weight 16
setp wsum.3.bit.5.weight 32
setp wsum.3.bit.6.weight 64
setp wsum.3.bit.7.weight 128
setp wsum.3.bit.8.weight 256
setp wsum.3.bit.9.weight 512
setp wsum.3.bit.10.weight 1024
setp wsum.3.bit.11.weight 2048
setp wsum.3.bit.12.weight 4096
setp wsum.3.bit.13.weight 8192
setp wsum.3.bit.14.weight 16384
setp wsum.3.bit.15.weight 32768

net pnpmb02-out-bitmask-hi    wsum.3.sum
net pnpmb02-out-bitmask-hi    convsu4.in
net pnpmb02-out-word-hi       convsu4.out
net pnpmb02-out-word-hi       hm2_modbus.0.io-pnpmb-02.outputs-b-00

net io-pnpmb02-out17 => wsum.3.bit.0.in
net io-pnpmb02-out18 => wsum.3.bit.1.in
