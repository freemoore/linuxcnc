<?xml version="1.0" encoding="UTF-8"?>

<mesamodbus baudrate="9600" parity="N" interval="100" stopbits="1" txdelay="20" rxdelay="20" suspend="true">
    <devices>
        <device name="bd600vfd" address="0x01"/>
        <device name="io-mb-01" address="0x02"/>
        <device name="io-mb-02" address="0x03"/>
        <device name="io-mb-03" address="0x04"/>
    </devices>

    <initlist>
        <command device="bd600vfd" address="0x1000" function="6">
            <description>VFD: decelerate to stop on init</description>
            <data value="0x0006"/>
        </command>
        <command device="io-mb-01" address="0x0070" function="6">
            <description>Board 1: All outputs OFF</description>
            <data value="0"/>
        </command>
        <command device="io-mb-02" address="0x0070" function="6">
            <description>Board 2: All outputs OFF</description>
            <data value="0"/>
        </command>
        <command device="io-mb-03" address="0x0070" function="6">
            <description>Board 3: All outputs OFF</description>
            <data value="0"/>
        </command>
    </initlist>

    <commands>

        <command device="bd600vfd" function="6" address="0x1000" resend="1">
            <description>Run command: fwd=1 rev=2 decel-stop=6 fault-reset=7</description>
            <pin name="cmd-run" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="6" address="0x3000" resend="1">
            <description>Frequency setpoint: 0-10000 = 0-100pct of F00.03 max freq</description>
            <pin name="set-freq-pct" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="6" address="0xF00C" resend="1">
            <description>Set acceleration time (units per F00.14, default 0.1s resolution)</description>
            <pin name="set-accel-time" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="6" address="0xF00D" resend="1">
            <description>Set deceleration time (units per F00.14, default 0.1s resolution)</description>
            <pin name="set-decel-time" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="3" address="0xF00C">
            <description>Read acceleration time readback</description>
            <pin name="accel-time" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="3" address="0xF00D">
            <description>Read deceleration time readback</description>
            <pin name="decel-time" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="3" address="0x2000">
            <description>Drive status: 1=fwd running 2=rev running 3=stopped</description>
            <pin name="status" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="3" address="0x3001" count="7">
            <description>Monitoring block 0x3001-0x3007: running-freq bus-v out-v out-a out-pwr out-trq rpm</description>
            <pin name="running-freq"   modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="bus-voltage"    modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="output-voltage" modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="output-current" modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="output-power"   modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="output-torque"  modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="rpm"            modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="3" address="0x8000">
            <description>Live fault code: 0=no fault, see manual appendix A for codes</description>
            <pin name="fault-live" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd600vfd" function="3" address="0xF91B" count="3">
            <description>Fault history: F09.27=current F09.28=2nd-recent F09.29=oldest. Addr rule: group*0x100+param</description>
            <pin name="fault-history-00" modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="fault-history-01" modbustype="U_AB" haltype="HAL_U32"/>
            <pin name="fault-history-02" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="io-mb-01" address="0x00C0" function="3" name="inputs-all"  haltype="HAL_U32" modbustype="U_AB" count="1"/>
        <command device="io-mb-01" address="0x0070" function="6" name="outputs-all" haltype="HAL_U32" modbustype="U_AB"/>
        <command device="io-mb-02" address="0x00C0" function="3" name="inputs-all"  haltype="HAL_U32" modbustype="U_AB" count="1"/>
        <command device="io-mb-02" address="0x0070" function="6" name="outputs-all" haltype="HAL_U32" modbustype="U_AB"/>
        <command device="io-mb-03" address="0x00C0" function="3" name="inputs-all"  haltype="HAL_U32" modbustype="U_AB" count="1"/>
        <command device="io-mb-03" address="0x0070" function="6" name="outputs-all" haltype="HAL_U32" modbustype="U_AB"/>

    </commands>
</mesamodbus>
