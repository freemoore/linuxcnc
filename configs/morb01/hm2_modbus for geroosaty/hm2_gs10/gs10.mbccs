   <command device="gs10" address="0x2101" function="R_REGISTERS" name="status"  haltype="HAL_U32" modbustype="U_AB" count="1"/>
   <command device="gs10" address="0x2104" function="R_REGISTERS" name="output-current"  haltype="HAL_FLOAT" modbustype="U_AB" count="1"/>
   <command device="gs10" address="0x2105" function="R_REGISTERS" name="bus-voltage"  haltype="HAL_FLOAT" modbustype="U_AB" count="1"/>
   <command device="gs10" address="0x210C" function="R_REGISTERS" name="motor-speed"  haltype="HAL_FLOAT" modbustype="U_AB" count="1"/>
   <command device="gs10" address="0x2001" function="W_REGISTER"  name="frequency-command"  haltype="HAL_FLOAT" modbustype="U_AB"/>
   <command device="gs10" address="0x2000" function="W_REGISTER"  name="operation"  haltype="HAL_U32" modbustype="U_AB"/>
