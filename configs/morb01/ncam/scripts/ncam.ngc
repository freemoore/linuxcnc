o<emill_chng_001_lc> endif

o<emill_chng_001_01> if [[#<_spindle_dir> GT 0] AND #<_spindle_all_time>]
	o<set_feed_rate_and_speed> CALL [1]
o<emill_chng_001_01> endif
(end End Mill Change)


