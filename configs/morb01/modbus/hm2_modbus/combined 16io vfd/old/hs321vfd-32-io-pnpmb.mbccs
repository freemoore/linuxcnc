<?xml version="1.0" encoding="UTF-8"?>

<mesamodbus baudrate="9600" parity="N" interval="100" stopbits="1" txdelay="20" rxdelay="20" suspend="true">
    <devices>
        <device name="bd6007r5gvfd"         address="0x01" />
        <device name="io-pnpmb-01"      address="0x02"/>
        <device name="io-pnpmb-02"      address="0x03"/>
    </devices>

 <initlist>
   <command device="io-pnpmb-01" address="0x0070" function="6">
     <description>Board 1: All outputs low word OFF</description>
     <data value="0"/>
   </command>
   <command device="io-pnpmb-01" address="0x0071" function="6">
     <description>Board 1: All outputs high word OFF</description>
     <data value="0"/>
   </command>
   <command device="io-pnpmb-02" address="0x0070" function="6">
     <description>Board 2: All outputs low word OFF</description>
     <data value="0"/>
   </command>
   <command device="io-pnpmb-02" address="0x0071" function="6">
     <description>Board 2: All outputs high word OFF</description>
     <data value="0"/>
   </command>
 </initlist>

    <commands>
        <command device="bd6007r5gvfd"      function="6"    address="0x2000" resend="1" noanswer="0">
            <pin name="set-status"      modbustype="S_AB"   haltype="HAL_S32"/>
        </command>

        <command device="bd6007r5gvfd"      function="6"    address="0x1000" resend="1" noanswer="0">
            <pin name="set-pc-max-rpm"  modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="6"    address="0x000C" resend="1" noanswer="0">
            <pin name="set-accel-time"  modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="6"    address="0x000D" resend="1" noanswer="0">
            <pin name="set-decel-time"  modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="3"    address="0x000C">
            <pin name="accel-time"      modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="3"    address="0x000D">
            <pin name="decel-time"      modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="3"    address="0x3000">
            <pin name="status"          modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="3"    address="0x7000" count="5">
            <pin name="running-freq"    modbustype="S_AB"   haltype="HAL_S32"/>
            <pin name="set-freq"        modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="bus-voltage"     modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="output-voltage"  modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="output-current"  modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="3"    address="0x7018">
            <pin name="rpm"             modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd" function="6" address="0x0011">
            <pin name="param-init" modbustype="U_AB" haltype="HAL_U32"/>
        </command>

        <command device="bd6007r5gvfd"      function="3"    address="0x0B03" count="7">
            <pin name="fault-current"   modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="fault-prev1"     modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="fault-prev2"     modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="fault-voltage"   modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="fault-amps"      modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="fault-freq-set"  modbustype="U_AB"   haltype="HAL_U32"/>
            <pin name="fault-freq-run"  modbustype="U_AB"   haltype="HAL_U32"/>
        </command>

        <command device="io-pnpmb-01" address="0x00C0" function="3" name="inputs-a" haltype="HAL_U32" modbustype="U_AB" count="1"/>
        <command device="io-pnpmb-01" address="0x00C1" function="3" name="inputs-b" haltype="HAL_U32" modbustype="U_AB" count="1"/>
        <command device="io-pnpmb-01" address="0x0070" function="6" name="outputs-a" haltype="HAL_U32" modbustype="U_AB"/>
        <command device="io-pnpmb-01" address="0x0071" function="6" name="outputs-b" haltype="HAL_U32" modbustype="U_AB"/>
        <command device="io-pnpmb-02" address="0x00C0" function="3" name="inputs-a" haltype="HAL_U32" modbustype="U_AB" count="1"/>
        <command device="io-pnpmb-02" address="0x00C1" function="3" name="inputs-b" haltype="HAL_U32" modbustype="U_AB" count="1"/>
        <command device="io-pnpmb-02" address="0x0070" function="6" name="outputs-a" haltype="HAL_U32" modbustype="U_AB"/>
        <command device="io-pnpmb-02" address="0x0071" function="6" name="outputs-b" haltype="HAL_U32" modbustype="U_AB"/>

    </commands>
</mesamodbus>
