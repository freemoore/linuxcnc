# Generated by PNCconf at Fri Jan  2 20:29:52 2026
# Using LinuxCNC version:  Master (2.9)
# --- Load all RT components ---
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt hostmot2
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_pktuarts=1 sserial_port_0=0000000" 
##loadrt hm2_modbus ports=[HMOT](CARD0).pktuart.0 mbccbs=bd600vfd.mbccb debug=5
loadrt pid names=pid.x,pid.y,pid.z,pid.a,pid.b
loadrt scale names=freqdispscale,ampsdispscale,fq-to-pc,fault-reset-scale,accelscale,decelscale
#loadrt conv_float_u32 names=freqconv,fault-reset-conv,
loadrt conv_float_s32 names=freq-to-s32,freq-to-s32-cmd
loadrt conv_u32_float names=freqdispconv,ampsdispconv,rpmdispconv,fault-code-to-float,accelconv,decelconv,faultcodeconv
loadrt limit1 names=spindlemaxvel
loadrt near names=spindle-at-speed-detect
loadrt wcomp names=spindle-fault-detect
loadrt or2 names=feed-hold-or
loadrt mux4 count=1

loadusr -Wn bd600 mb2hal config=bd600vfd_mb2hal.ini

setp    [HMOT](CARD0).pwmgen.pwm_frequency 75000
setp    [HMOT](CARD0).watchdog.timeout_ns 10000000

addf [HMOT](CARD0).read         servo-thread
addf motion-command-handler   	servo-thread
addf motion-controller       	servo-thread
addf pid.x.do-pid-calcs       	servo-thread
addf pid.y.do-pid-calcs       	servo-thread
addf pid.z.do-pid-calcs       	servo-thread
addf pid.a.do-pid-calcs       	servo-thread
addf pid.b.do-pid-calcs       	servo-thread
addf fq-to-pc 					servo-thread
addf spindlemaxvel 				servo-thread
##addf hm2_modbus.0.process		servo-thread
addf freqdispconv 				servo-thread
addf ampsdispconv 				servo-thread
addf rpmdispconv 				servo-thread
addf fault-code-to-float 		servo-thread
addf accelconv 					servo-thread
addf decelconv 					servo-thread
addf freqdispscale 				servo-thread
addf ampsdispscale 				servo-thread
addf accelscale 				servo-thread
addf decelscale 				servo-thread
addf spindle-fault-detect 		servo-thread
addf feed-hold-or 				servo-thread
#addf fault-reset-mux 			servo-thread
addf faultcodeconv 				servo-thread
addf spindle-at-speed-detect 	servo-thread
addf freq-to-s32				servo-thread
addf freq-to-s32-cmd 			servo-thread
addf mux4.0        				servo-thread

addf [HMOT](CARD0).write        servo-thread


#  ---HALUI signals---
net jog-selected-pos      halui.axis.selected.plus
net jog-selected-neg      halui.axis.selected.minus
net MDI-mode              halui.mode.is-mdi

#  ---coolant signals---
net coolant-mist      <=  iocontrol.0.coolant-mist
net coolant-flood     <=  iocontrol.0.coolant-flood
#  ---probe signal---
net probe-in     =>  motion.probe-input
#  ---motion control signals---
net in-position               <=  motion.in-position


