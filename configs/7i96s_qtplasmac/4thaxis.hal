# Axis: A Joint: 3 Output: 3
## PID Setup

setp   pid.a.Pgain     [JOINT_0]P
setp   pid.a.Igain     [JOINT_0]I
setp   pid.a.Dgain     [JOINT_0]D
setp   pid.a.bias      [JOINT_0]BIAS
setp   pid.a.FF0       [JOINT_0]FF0
setp   pid.a.FF1       [JOINT_0]FF1
setp   pid.a.FF2       [JOINT_0]FF2
setp   pid.a.deadband  [JOINT_0]DEADBAND
setp   pid.a.maxoutput [JOINT_0]MAX_OUTPUT
setp   pid.a.error-previous-target true
# This setting is to limit bogus stepgen
# velocity corrections caused by position
# feedback sample time jitter.
setp   pid.a.maxerror 0.012700

net a-index-enable  =>  pid.a.index-enable
net a-enable        =>  pid.a.enable
net a-pos-cmd       =>  pid.a.command
net a-pos-fb        =>  pid.a.feedback
net a-output        <=  pid.a.output

# joint-3 enable chain
#net joint-3-index-enable <=> pid.a.index-enable
#net joint-3-index-enable <=> joint.3.index-enable
#net joint-3-enable <= joint.3.amp-enable-out
#net joint-3-enable => pid.a.enable
#net joint-3-enable => hm2_7i96s.0.stepgen.03.enable

## Joint 3 Step Generator Settings
setp hm2_7i96s.0.stepgen.03.dirsetup [JOINT_3]DIRSETUP
setp hm2_7i96s.0.stepgen.03.dirhold [JOINT_3]DIRHOLD
setp hm2_7i96s.0.stepgen.03.steplen [JOINT_3]STEPLEN
setp hm2_7i96s.0.stepgen.03.stepspace [JOINT_3]STEPSPACE
setp hm2_7i96s.0.stepgen.03.position-scale [JOINT_3]STEP_SCALE
setp hm2_7i96s.0.stepgen.03.maxvel [JOINT_3]STEPGEN_MAXVEL
setp hm2_7i96s.0.stepgen.03.maxaccel [JOINT_3]STEPGEN_MAXACCEL
setp hm2_7i96s.0.stepgen.03.step_type 0
setp hm2_7i96s.0.stepgen.03.control-type 1

# position command and feedback
net joint-3-pos-cmd <= joint.3.motor-pos-cmd
#net joint-3-pos-cmd => pid.a.command
net joint-3-pos-fb <= hm2_7i96s.0.stepgen.03.position-fb
net joint-3-pos-fb => joint.3.motor-pos-fb
#net joint-3-pos-fb => pid.a.feedback

# PID Output
#net joint.3.output <= pid.a.output
net joint.3.output => hm2_7i96s.0.stepgen.03.velocity-cmd
