(begin Workpiece)
(workpiece definition author : Fernand Veilleux)

#<wp_width>         = [1220.000000]
#<wp_length>        = [2440.000000]
#<wp_depth>         = [25.400000]
#<wp_wall>          = [0.000000]
#<wp_corner_radius> = [0.000000]
#<wp_inside_width>  = [#<wp_width> - #<wp_wall> * 2]
#<wp_inside_length> = [#<wp_length> - #<wp_wall> * 2]

#<wp_x> = 0.000000
#<wp_y> = 0.000000

o<select> CALL [31] [0] [0.000000] [0.000000 - #<wp_length> / 2] [0.000000 - #<wp_length>]
#<wp_left>  = #31
#<wp_right> = [#<wp_left> + #<wp_length>]

o<select> CALL [31] [2] [0.000000 - #<wp_width>] [0.000000 - #<wp_width> / 2] [0.000000]
#<wp_front> = #31
#<wp_rear>  = [#<wp_front> + #<wp_width>]

o<select> CALL [31] [0] [0.000000] [0.000000 + #<wp_depth> / 2] [0.000000 + #<wp_depth>]
#<surface>  = #31

#<_z_clear>       = 2.540000
#<_rapid_z>       = [#<surface> + #<_z_clear> + 10.160000]

#<bottom>         = [#<surface> - #<wp_depth>]
#<bottom_through> = [#<bottom> + -1.270000]

/	o<workpiece_001_active> if [1 AND #<_show_final_cuts>] (show active)
/		o<stock> CALL [#<wp_left>] [#<wp_right>] [#<wp_front>] [#<wp_rear>] [#<surface>] [#<bottom>] [0] [#<wp_corner_radius>] [#<wp_wall>]
/		G0 X0.000000 Y0.000000 Z#<surface>
/	o<workpiece_001_active> endif

(end Workpiece)


(begin Drill/Reamer Change)
(drill change params and changing code author : Fernand Veilleux)

#<_drill_feed>       =  500.000000
#<_drill_retract>    =  0.508000
#<_drill_mode>       =  81
#<_drill_dwell>      =  2.000000
#<_drill_q>          =  5.080000
#<_drill_rpm>        =  3000
#<_spindle_dir>      =  3
#<_cooling_mode>     =  8

#<_rpm_normal>       =  3000
#<_feed_vertical>    =  500.000000
#<_tool_usage>       =  3

o<select> CALL [31] [1] [9.525000] [0.3125] [0.2362] [0.1285] [0.257] [0]
#<drill_diameter> = #31
o<drill_chng_001_metric> if [[#<_metric> EQ 1] AND [1 NE 0]]
	#<drill_diameter> = [#<drill_diameter> * 25.4]
o<drill_chng_001_metric> endif

#<drill_point_len> = [[#<drill_diameter> / 2] / TAN[118 / 2]]
(print,Drill info : diameter = #<drill_diameter>, point angle = 118 &#176;, point length = #<drill_point_len>)

o<drill_chng_001_tlc> if [[3 EQ 3] AND [2 GT 0]]
	M61 Q2
o<drill_chng_001_tlc> endif

o<drill_chng_001_act> if [1 AND [2 NE #5400]]
	M9
	T2 M6
o<drill_chng_001_act> endif

o<drill_chng_001_lc> if [[3 EQ 1] OR [3 EQ 2]]
	G43 H2
o<drill_chng_001_lc> endif

o<drill_chng_001_01> if [[#<_spindle_dir> GT 0] AND #<_spindle_all_time>]
	o<set_spindle_rpm> CALL [#<_drill_rpm>]
	F#<_drill_feed>
o<drill_chng_001_01> endif
(end Drill/Reamer Change)


(begin Drill Array)
(drill 1 by 4 holes author : Fernand Veilleux)

o<drill-array_001_active> if [1 AND [#<_tool_usage> EQ 3]] (if active)
	o<select> CALL [31] [1] [0.000000] [#<surface>] [#<surface> - #<wp_depth> / 2] [#<surface> - #<wp_depth> / 4] [#<bottom> + #<wp_depth> / 4] [0]
	o<select> CALL [32] [0] [-25.000000] [#<bottom_through>] [#31 + #<center_drill_depth>] [#<bottom>] [#<surface> - #<wp_depth> / 2] [#<surface> - #<wp_depth> / 4] [#<bottom> + #<wp_depth> / 4] [0]

	o<drill-array_001_01> if [1 EQ 1]
		#33 = 0
	o<drill-array_001_01> else
		o<select> CALL [33] [0] [600.000000] [600.000000 / [1 - 1]]
	o<drill-array_001_01> endif
	#<dx10> = #33
	o<select> CALL [33] [0] [0] [- [1 - 1] * #<dx10> / 2] [- [1 - 1] * #<dx10>]
	#<first_x10> = #33

	o<drill-array_001_02> if [4 EQ 1]
		#33 = 0
	o<drill-array_001_02> else
		o<select> CALL [33] [0] [300.000000] [300.000000 / [4 - 1]]
	o<drill-array_001_02> endif
	#<dy10> = #33
	o<select> CALL [33] [1] [- #<dy10> * [4 - 1]] [- #<dy10> * [4 - 1] / 2] [0]
	#<first_y10> = #33

	(get and save current coords system offsets)
	#<old_coord_system10> = [#<_coord_system> / 10]
	o<get_offsets> CALL
	#<offset_x10> = #<_offsets_x>
	#<offset_y10> = #<_offsets_y>
	#<offset_z10> = #<_offsets_z>
	#<offset_r10> = #<_offsets_r>

	(change coords system)
	G#<_off_rot_coord_system>

	o<set_spindle_rpm> CALL [#<_drill_rpm>] [#<_drill_feed>]
	#<start_y10> = [#<offset_y10> + #<first_y10>]
	#<x_step10>  = 1
	#<x_round10> = 0
	#<start_x10> = [#<offset_x10> + #<first_x10>]

	o<drill-array_001_loop_Y> repeat [4]
		o<drill-array_001_loop_X> repeat [1]
			(get rotated coordinates then apply to new coords)
			o<rotate_xy> CALL [#<start_x10> + 2420.000000] [#<start_y10> + 610.000000] [#<offset_x10> + 2420.000000] [#<offset_y10> + 610.000000] [#<offset_r10> + 0.000000]
			G10 L2 P#5220 X[#<_rotated_x>] Y[#<_rotated_y>] Z#<offset_z10> R[#<offset_r10> + 0.000000]

			o<drill_single> CALL [0] [0] [#31] [#32] [#<drill_diameter>] [#<drill_point_len>] [1]

			#<x_round10> = [#<x_round10> + #<x_step10>]
			o<drill-array_001_inc> if [[#<x_round10> LT 1] AND [#<x_round10> GT 0]]
				#<start_x10>  = [#<start_x10>  + #<dx10> * #<x_step10>]
			o<drill-array_001_inc> endif
		o<drill-array_001_loop_X> endrepeat

		#<x_step10>  = [#<x_step10>   * -1]
		#<start_y10> = [#<start_y10> + #<dy10>]
	o<drill-array_001_loop_Y> endrepeat

	o<drill-array_001_stop> if [#<_spindle_all_time> EQ 0]
		M9 M5
	o<drill-array_001_stop> endif

	(restore coordinate system)
	G#<old_coord_system10>
	G10 L2 P#5220 X#<offset_x10> Y#<offset_y10> Z#<offset_z10> R#<offset_r10>

o<drill-array_001_active> endif
(end Drill Array)

 
M2
